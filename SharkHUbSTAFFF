-- Diagnostic Debug Button Handler
DebugPickupBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        DebugPickupBtn.Text = "⚠️ ERROR: NO CHAR/HRP"
        task.delay(2, function() DebugPickupBtn.Text = "🐛 DEBUG AUTO PICKUP" end)
        return
    end

    local hrp = char.HumanoidRootPart
    local dropsFolder = Workspace:FindFirstChild("Drops") or Workspace
    local totalScanned = 0
    local matchedCount = 0
    local pulledCount = 0

    print("--- [SHARK HUB] AUTO PICKUP DIAGNOSTICS ---")
    print("Character Root Found:", hrp:GetFullName())
    print("Executor supports firetouchinterest:", tostring(firetouchinterest ~= nil))
    print("Whitelist State:", tostring(USE_WHITELIST))
    print("Scanning Folder:", dropsFolder:GetFullName())

    for _, obj in ipairs(dropsFolder:GetChildren()) do
        totalScanned = totalScanned + 1
        local itemName = obj.Name
        local matched = false

        if USE_WHITELIST then
            for targetName, _ in pairs(TARGET_ITEMS_LOOKUP) do
                if string.find(string.lower(itemName), string.lower(targetName)) then
                    matched = true
                    break
                end
            end
        else
            matched = true
        end

        if matched then
            matchedCount = matchedCount + 1
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart") or (obj:IsA("BasePart") and obj)
            if handle then
                pulledCount = pulledCount + 1
                -- Force CFrame Teleport + Fire Touch Interest Test
                handle.CFrame = hrp.CFrame
                if firetouchinterest then
                    firetouchinterest(hrp, handle, 0)
                    firetouchinterest(hrp, handle, 1)
                end
            end
        end
    end

    print(string.format("DIAGNOSTIC COMPLETE: %d scanned | %d matched | %d physical parts pulled", totalScanned, matchedCount, pulledCount))
    print("------------------------------------------")

    if totalScanned == 0 then
        DebugPickupBtn.Text = "⚠️ 0 DROPS IN WORKSPACE"
    elseif matchedCount == 0 then
        DebugPickupBtn.Text = "⚠️ NO WHITELIST MATCHES"
    else
        DebugPickupBtn.Text = string.format("✅ PULLED %d DROPS!", pulledCount)
    end

    task.delay(2.5, function() DebugPickupBtn.Text = "🐛 DEBUG AUTO PICKUP" end)
end)

