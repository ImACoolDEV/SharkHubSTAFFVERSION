            while AUTO_DISABLE_CONE_ENABLED do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local coneRealm = Workspace:FindFirstChild("ConeRealm")
                local eventFolder = coneRealm and coneRealm:FindFirstChild("Event")

                if hrp and eventFolder then
                    for _, coneObj in ipairs(eventFolder:GetChildren()) do
                        if not AUTO_DISABLE_CONE_ENABLED then break end
                        
                        local hasHighlight = coneObj:FindFirstChildOfClass("Highlight") or coneObj:FindFirstChild("Highlight", true)
                        
                        if hasHighlight and not visitedCones[coneObj] then
                            local targetPart = coneObj:IsA("BasePart") and coneObj 
                                or coneObj:FindFirstChild("Handle") 
                                or coneObj:FindFirstChildWhichIsA("BasePart", true)
                                
                            if targetPart then
