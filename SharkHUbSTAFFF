AUTO_PICKUP_ENABLED = true
pickupLoop = RunService.Heartbeat:Connect(function()
    if not AUTO_PICKUP_ENABLED then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local dropsFolder = Workspace:FindFirstChild("Drops") or Workspace
    for _, obj in ipairs(dropsFolder:GetChildren()) do
        local itemName = obj.Name
        local matched = false
        if USE_WHITELIST then
            for targetName, _ in pairs(TARGET_ITEMS_LOOKUP) do
                if string.find(string.lower(itemName), string.lower(targetName)) then matched = true break end
            end
        else matched = true end

        if matched then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart") or (obj:IsA("BasePart") and obj)
            if handle then
                if firetouchinterest then
                    firetouchinterest(hrp, handle, 0)
                    firetouchinterest(hrp, handle, 1)
                else
                    handle.CFrame = hrp.CFrame
                end
            end
        end
    end
end)
table.insert(_G.SharkHubConnections, pickupLoop)

