local function CreateStaffButton(text, order, initialActive)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.LayoutOrder = order
    btn.ZIndex = 12
    btn.Parent = ScrollingFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)
    
    local grad = Instance.new("UIGradient")
    grad.Color = initialActive and GREEN_ON_GRADIENT or GREEN_OFF_GRADIENT
    grad.Rotation = 90
    grad.Parent = btn

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.5
    stroke.Color = initialActive and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(40, 130, 80)

    return btn, stroke, grad
end

