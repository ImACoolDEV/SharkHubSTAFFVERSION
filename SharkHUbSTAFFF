local cachedRemotes = { GiftRain = {}, LootItem = {}, SpawnItem = {} }

local function updateRemoteCache()
    table.clear(cachedRemotes.GiftRain)
    table.clear(cachedRemotes.LootItem)
    table.clear(cachedRemotes.SpawnItem)
    local search = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
    for _, obj in ipairs(search:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("BindableEvent") then
            local n = obj.Name:lower()
            if n:find("giftrain") then table.insert(cachedRemotes.GiftRain, obj)
            elseif n:find("lootitem") and not n:find("player") then table.insert(cachedRemotes.LootItem, obj)
            elseif n:find("spawnitem") then table.insert(cachedRemotes.SpawnItem, obj) end
        end
    end
end
updateRemoteCache()

local function findTargetModel(query)
    local qLower = query:lower()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:lower():find(qLower) then
            local p = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart")
            if p then return obj, p end
        end
    end
    return nil, nil
end

local function runSlashLoop10x()
    if #cachedRemotes.GiftRain == 0 and #cachedRemotes.LootItem == 0 and #cachedRemotes.SpawnItem == 0 then updateRemoteCache() end

    for iteration = 1, 10 do
        for _, obj in ipairs(cachedRemotes.SpawnItem) do
            pcall(function()
                if obj:IsA("BindableEvent") then obj:Fire("SlashProjectile2") else obj:FireServer("SlashProjectile2") end
            end)
        end
        for _, obj in ipairs(cachedRemotes.GiftRain) do
            pcall(function()
                if obj:IsA("BindableEvent") then obj:Fire("SlashProjectile2", 100) else obj:FireServer("SlashProjectile2", 100) end
            end)
        end
        for _, obj in ipairs(cachedRemotes.LootItem) do
            pcall(function()
                if obj:IsA("BindableEvent") then obj:Fire("SlashProjectile2") else obj:FireServer("SlashProjectile2") end
            end)
        end

        local _, rakePart = findTargetModel(RAKE_NAME)
        if rakePart then
            local rakeCFrame = rakePart.CFrame
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "SlashProjectile2" then
                    if obj:IsA("Model") then
                        obj:PivotTo(rakeCFrame)
                    elseif obj:IsA("BasePart") then
                        obj.CFrame = rakeCFrame
                    end
                end
            end
        end
        task.wait(0.15)
    end
end

local function triggerGiftRainAndLoot(multiplier)
    if #cachedRemotes.GiftRain == 0 and #cachedRemotes.LootItem == 0 then updateRemoteCache() end
    for _, obj in ipairs(cachedRemotes.GiftRain) do
        pcall(function() if obj:IsA("BindableEvent") then obj:Fire(multiplier) else obj:FireServer(multiplier) end end)
    end
    for _, obj in ipairs(cachedRemotes.LootItem) do
        pcall(function() if obj:IsA("BindableEvent") then obj:Fire(multiplier) else obj:FireServer(multiplier) end end)
    end
end

local function getDropContainers()
    local containers = {}
    local rsDrops = ReplicatedStorage:FindFirstChild("Drops")
    if rsDrops then table.insert(containers, rsDrops) end
    table.insert(containers, ReplicatedStorage)
    local wsDrops = Workspace:FindFirstChild("Drops")
    if wsDrops then table.insert(containers, wsDrops) end
    table.insert(containers, Workspace)
    return containers
end

local function playerHasItem(itemName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char and char:FindFirstChild(itemName) then return true end
    if backpack and backpack:FindFirstChild(itemName) then return true end
    return false
end

