Tasks.Radar = task.spawn(function()
    while true do
        if RadarFrame.Visible then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local closestItem, closestDistance = nil, math.huge
                for _, container in ipairs(getDropContainers()) do
                    for _, item in ipairs(container:GetChildren()) do
                        local matchedName = nil
                        for tName, _ in pairs(TARGET_ITEMS_LOOKUP) do if item.Name:lower():find(tName) then matchedName = tName break end end
                        if matchedName then
                            local part = item:IsA("BasePart") and item or item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                            if part then
                                local dist = (hrp.Position - part.Position).Magnitude
                                if dist < closestDistance then closestDistance = dist closestItem = matchedName end
                            end
                        end
                    end
                end
                if closestItem and closestDistance <= 150 then
                    RadarItemName.Text = "🎁 " .. closestItem
                    RadarItemInfo.Text = string.format("Dist: %d studs | Chance: %s", math.floor(closestDistance), ITEM_PROBABILITIES[closestItem] or "40%")
                else
                    RadarItemName.Text = "🎁 No Target Drops Nearby" RadarItemInfo.Text = "Scanning workspace..."
                end
            end

            local curHP, maxHP = nil, nil
            local hpObj = Workspace:FindFirstChild("RakoofHP", true) or ReplicatedStorage:FindFirstChild("RakoofHP", true)
            local maxHpObj = Workspace:FindFirstChild("RakoofMaxHP", true) or ReplicatedStorage:FindFirstChild("RakoofMaxHP", true)

            if hpObj and maxHpObj then
                if hpObj:IsA("ValueBase") then curHP = hpObj.Value end
                if maxHpObj:IsA("ValueBase") then maxHP = maxHpObj.Value end
            end

            if curHP == nil or maxHP == nil then
                local rakoofModel, _ = findTargetModel(TARGET_NAME)
                if rakoofModel then
                    local attrHp = rakoofModel:GetAttribute("RakoofHP") or rakoofModel:GetAttribute("HP")
                    local attrMaxHp = rakoofModel:GetAttribute("RakoofMaxHP") or rakoofModel:GetAttribute("MaxHP")
                    
                    if attrHp and attrMaxHp then
                        curHP, maxHP = attrHp, attrMaxHp
                    else
                        local hum = rakoofModel:FindFirstChildOfClass("Humanoid")
                        if hum then
                            curHP, maxHP = hum.Health, hum.MaxHealth
                        end
                    end
                end
            end

            if curHP ~= nil and maxHP ~= nil and maxHP > 0 then
                local ratio = math.clamp(curHP / maxHP, 0, 1)
                TweenService:Create(RakoofBarFill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(ratio, 0, 1, 0)
                }):Play()
                
                RakoofHPLabel.Text = string.format("❤ HP: %d / %d (%d%%)", math.floor(math.max(curHP, 0)), math.floor(maxHP), math.floor(ratio * 100))
            else
                TweenService:Create(RakoofBarFill, TweenInfo.new(0.2), {Size = UDim2.new(0, 0, 1, 0)}):Play()
                RakoofHPLabel.Text = "👻 RakoofHP / RakoofMaxHP Not Found"
            end
        end
        task.wait(0.25)
    end
end)

