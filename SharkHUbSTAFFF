-- AUTO DISABLE CONE
AutoDisableConeBtn.MouseButton1Click:Connect(function()
    Features.AutoDisableCone = not Features.AutoDisableCone
    AutoDisableConeBtn.Text = Features.AutoDisableCone and "🛑 AUTO DISABLE CONE: ON" or "🛑 AUTO DISABLE CONE: OFF"
    AutoDisableConeGrad.Color = Features.AutoDisableCone and SPECIAL_ORANGE_ON or SPECIAL_ORANGE_OFF
    AutoDisableConeStroke.Color = Features.AutoDisableCone and Color3.fromRGB(255, 230, 100) or Color3.fromRGB(255, 170, 0)

    if Features.AutoDisableCone then
        table.clear(visitedCones)
        Tasks.Cone = task.spawn(function()
            while Features.AutoDisableCone do
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local eventFolder = Workspace:FindFirstChild("ConeRealm") and Workspace.ConeRealm:FindFirstChild("Event")
                if hrp and eventFolder then
                    for _, coneObj in ipairs(eventFolder:GetChildren()) do
                        if not Features.AutoDisableCone then break end
                        if coneObj:FindFirstChildOfClass("Highlight") and not visitedCones[coneObj] then
                            local targetPart = coneObj:IsA("BasePart") and coneObj or coneObj:FindFirstChildWhichIsA("BasePart", true)
                            if targetPart then
                                hrp.CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
                                visitedCones[coneObj] = true
                                task.wait(0.15)
                                local prompt = coneObj:FindFirstChildOfClass("ProximityPrompt", true)
                                if prompt and fireproximityprompt then fireproximityprompt(prompt) end
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                task.wait(1.75)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            end
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    elseif Tasks.Cone then task.cancel(Tasks.Cone) Tasks.Cone = nil end
end)

