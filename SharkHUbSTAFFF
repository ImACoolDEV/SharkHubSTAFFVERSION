local cachedRemotes = { GiftRain = {}, LootItem = {}, SpawnItem = {} }
local function updateRemoteCache()
    table.clear(cachedRemotes.GiftRain)
    table.clear(cachedRemotes.LootItem)
    table.clear(cachedRemotes.SpawnItem)
    local search = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
    for _, obj in ipairs(search:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("BindableEvent") then
            local n = obj.Name:lower()
            if n:find("giftrain") then table.insert(cachedRemotes.GiftRain, obj)
            elseif n:find("lootitem") and not n:find("player") then table.insert(cachedRemotes.LootItem, obj)
            elseif n:find("spawnitem") then table.insert(cachedRemotes.SpawnItem, obj) end
        end
    end
end
