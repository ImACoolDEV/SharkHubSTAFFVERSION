            for _, targetName in ipairs({RAKE_NAME, TARGET_NAME}) do
                local _, targetPart = findTargetModel(targetName)
                if targetPart then
                    if not originalHitboxSizes[targetPart] then
                        originalHitboxSizes[targetPart] = {Size = targetPart.Size, Transparency = targetPart.Transparency}
                    end
                    targetPart.Size = Vector3.new(20, 20, 20)
                    targetPart.Transparency = 0.7
                end
            end
        end)
    else
        if hitboxLoop then hitboxLoop:Disconnect() hitboxLoop = nil end
        for part, props in pairs(originalHitboxSizes) do
            if part and part.Parent then
                part.Size = props.Size
                part.Transparency = props.Transparency
            end
        end
        table.clear(originalHitboxSizes)
    end
end)

