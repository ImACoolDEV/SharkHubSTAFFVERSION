safeBindClick(FlyBtn, function()
    Features.Fly = not Features.Fly
    updateStateUI(FlyBtn, FlyStroke, FlyGrad, Features.Fly, "🦅 FLY HACK: ON", "🦅 FLY HACK: OFF")
    if Connections.Fly then Connections.Fly:Disconnect() Connections.Fly = nil end
    if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    if Features.Fly then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            flyBodyVel = Instance.new("BodyVelocity", hrp) flyBodyVel.MaxForce = Vector3.new(1,1,1)*1e6 flyBodyVel.Velocity = Vector3.zero
            flyBodyGyro = Instance.new("BodyGyro", hrp) flyBodyGyro.MaxTorque = Vector3.new(1,1,1)*1e6 flyBodyGyro.CFrame = hrp.CFrame
            Connections.Fly = RunService.RenderStepped:Connect(function()
                if not Features.Fly or not hrp then return end
                local cam = Workspace.CurrentCamera.CFrame
                flyBodyGyro.CFrame = cam
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                flyBodyVel.Velocity = (dir.Magnitude > 0) and (dir.Unit * 60) or Vector3.zero
            end)
        end
    end
end)

