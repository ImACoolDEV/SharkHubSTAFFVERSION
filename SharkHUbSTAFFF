-- AUTO SURVIVE BURNED BONE
AutoSurviveBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if playerHasItem("BurnedBone") then
        local rockMesh = ReplicatedStorage:FindFirstChild("rock", true)
        if rockMesh then
            local targetPos = rockMesh:IsA("BasePart") and rockMesh.CFrame or (rockMesh:FindFirstChildWhichIsA("BasePart") and rockMesh:FindFirstChildWhichIsA("BasePart").CFrame)
            if targetPos then
                hrp.CFrame = targetPos * CFrame.new(0, 4, 0)
                AutoSurviveBtn.Text = "✅ TELEPORTED TO ROCK!"
            end
        else
            AutoSurviveBtn.Text = "⚠️ ROCK MISSING!"
        end
    else
        AutoSurviveBtn.Text = "⚠️ NO BURNED BONE!"
    end

    task.delay(2.5, function() AutoSurviveBtn.Text = "🦴 AUTO SURVIVE BURNED BONE" end)
end)

