-- ONE-CLICK AUTO TRADE (Instant check, zero lag spikes)
AutoTradeActionBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. Check if item is already owned
    if checkAlreadyOwns(SELECTED_TRADE_ITEM) then
        AutoTradeActionBtn.Text = "⚠️ ALREADY OWN ITEM!"
        task.delay(2, function()
            AutoTradeActionBtn.Text = string.format("🤝 EXECUTE AUTO TRADE (%s)", SELECTED_TRADE_ITEM)
        end)
        return
    end

    -- 2. Check recipe ingredients in inventory
    local requiredIngredients = TRADE_RECIPES[SELECTED_TRADE_ITEM] or {}
    local hasAll = true
    for _, ingredient in ipairs(requiredIngredients) do
        if not playerHasItem(ingredient) then
            hasAll = false
            break
        end
    end

    -- 3. Teleport if ready
    if hasAll then
        local markObj = findTraderMark()
        if markObj and markObj:IsA("BasePart") then
            hrp.CFrame = markObj.CFrame * CFrame.new(0, 3, 0)
            AutoTradeActionBtn.Text = "✅ TELEPORTED TO MARK!"
        else
            AutoTradeActionBtn.Text = "⚠️ MARK NOT FOUND!"
        end
    else
        AutoTradeActionBtn.Text = "⚠️ MISSING ITEMS IN INV!"
    end

    task.delay(2.5, function()
        AutoTradeActionBtn.Text = string.format("🤝 EXECUTE AUTO TRADE (%s)", SELECTED_TRADE_ITEM)
    end)
end)

