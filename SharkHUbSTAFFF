local function updateDropProbabilityRadar()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local dropsFolder = Workspace:FindFirstChild("Drops") or Workspace
    local closestItem = nil
    local closestDistance = math.huge

    for _, item in ipairs(dropsFolder:GetChildren()) do
        local itemName = item.Name
        local matchedName = nil
        
        for tName, _ in pairs(TARGET_ITEMS_LOOKUP) do
            if string.find(string.lower(itemName), string.lower(tName)) then
                matchedName = tName
                break
            end
        end

        if matchedName then
            local part = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart") or (item:IsA("BasePart") and item)
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < closestDistance then
                    closestDistance = dist
                    closestItem = matchedName
                end
            end
        end
    end

    if closestItem and closestDistance <= 150 then
        local chance = ITEM_PROBABILITIES[closestItem] or ITEM_PROBABILITIES["Default"]
        RadarItemName.Text = "🎁 " .. closestItem
        RadarItemInfo.Text = "Distance: " .. tostring(math.floor(closestDistance)) .. " studs  |  Chance: " .. chance
    else
        RadarItemName.Text = "🎁 No Target Drops Nearby"
        RadarItemInfo.Text = "Scanning workspace..."
    end
end

dropRadarLoop = RunService.Heartbeat:Connect(function()
    if RadarFrame.Visible and tick() % 0.2 < 0.05 then
        updateDropProbabilityRadar()
    end
end)

