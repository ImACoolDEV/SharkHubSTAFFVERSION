    AutoTradeGrad.Color = AUTO_TRADE_ENABLED and GREEN_ON_GRADIENT or GREEN_OFF_GRADIENT
    AutoTradeStroke.Color = AUTO_TRADE_ENABLED and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(40, 130, 80)

    if AUTO_TRADE_ENABLED then
        autoTradeLoop = task.spawn(function()
            while AUTO_TRADE_ENABLED do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if hrp then
                    local alreadyOwned = checkAlreadyOwns(SELECTED_TRADE_ITEM)
                    
                    if not alreadyOwned then
                        local requiredIngredients = TRADE_RECIPES[SELECTED_TRADE_ITEM] or {}
                        local hasAllIngredients = true

                        for _, ingredient in ipairs(requiredIngredients) do
                            if not playerHasItem(ingredient) then
                                hasAllIngredients = false
                                break
                            end
                        end

                        if hasAllIngredients then
                            local markObj = findTraderMark()
                            if markObj and markObj:IsA("BasePart") then
                                hrp.CFrame = markObj.CFrame * CFrame.new(0, 3, 0)
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    else
        if autoTradeLoop then task.cancel(autoTradeLoop) autoTradeLoop = nil end
    end
end)

