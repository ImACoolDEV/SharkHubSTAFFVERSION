-- Remote Cache & Discovery (Optimized to prevent game-freezing game:GetDescendants calls)
local cachedRemotes = { DropItem = {}, SpawnDrop = {}, Transfer = {}, Emote = {}, CountPlayer = {} }

local function updateRemoteCache()
    for _, key in pairs(cachedRemotes) do table.clear(key) end
    local searchContainers = {ReplicatedStorage, Workspace, Players}
    for _, container in ipairs(searchContainers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("BindableEvent") then
                local nameLower = string.lower(obj.Name)
                for category, _ in pairs(cachedRemotes) do
                    if string.find(nameLower, string.lower(category)) then
                        table.insert(cachedRemotes[category], obj)
                    end
                end
            end
        end
    end
end
updateRemoteCache()

local function fireRemoteAction(category, ...)
    if #cachedRemotes[category] == 0 then updateRemoteCache() end
    for _, remote in ipairs(cachedRemotes[category]) do
        pcall(function()
            if remote:IsA("BindableEvent") then remote:Fire(...) else remote:FireServer(...) end
        end)
    end
end

local function findTargetModel(query)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), string.lower(query)) then
            local targetPart = obj:FindFirstChild("Torso")
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChildWhichIsA("BasePart")
            if targetPart then return obj, targetPart end
        end
    end
    return nil, nil
end

