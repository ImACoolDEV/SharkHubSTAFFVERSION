Connections.PlayerHPTracker = task.spawn(function()
    while true do
        if HealthFrame.Visible and HPContainer.Visible then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                local currentHP = math.clamp(hum.Health, 0, hum.MaxHealth)
                local ratio = math.clamp(currentHP / math.max(hum.MaxHealth, 1), 0, 1)
                HPBarFill.Size = UDim2.new(ratio, 0, 1, 0)
                HPTextLabel.Text = string.format("%d / %d HP [%d%%]", math.floor(currentHP), math.floor(hum.MaxHealth), math.floor(ratio * 100))
            end
        end
        task.wait(0.2)
    end
end)

Tasks.RakeHPTracker = task.spawn(function()
    while true do
        if RakeHPFrame.Visible then
            local rakeModel, _ = findTargetModel(RAKE_NAME)
            if not rakeModel then rakeModel, _ = findTargetModel(TARGET_NAME) end
            
            local curHP, maxHP = nil, nil
            if rakeModel then
                local hum = rakeModel:FindFirstChildOfClass("Humanoid")
                if hum then
                    curHP, maxHP = hum.Health, hum.MaxHealth
                else
                    curHP = rakeModel:GetAttribute("HP") or rakeModel:GetAttribute("Health")
                    maxHP = rakeModel:GetAttribute("MaxHP") or rakeModel:GetAttribute("MaxHealth")
                end
            end

            if curHP and maxHP and maxHP > 0 then
                local ratio = math.clamp(curHP / maxHP, 0, 1)
                RakeBarFill.Size = UDim2.new(ratio, 0, 1, 0)
                RakeHPText.Text = string.format("[TARGET] HP: %d / %d [%d%%]", math.floor(math.max(curHP, 0)), math.floor(maxHP), math.floor(ratio * 100))
            else
                RakeBarFill.Size = UDim2.new(0, 0, 1, 0)
                RakeHPText.Text = "[SCAN]: Target Not Located"
            end
        end
        task.wait(0.3)
    end
end)
