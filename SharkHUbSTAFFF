Tasks.RakeHPTracker = task.spawn(function()
    while true do
        if RakeHPFrame.Visible then
            local rakeModel, _ = findTargetModel(RAKE_NAME)
            if not rakeModel then rakeModel, _ = findTargetModel(TARGET_NAME) end
            
            local curHP, maxHP = nil, nil
            if rakeModel then
                local hum = rakeModel:FindFirstChildOfClass("Humanoid")
                if hum then
                    curHP, maxHP = hum.Health, hum.MaxHealth
                else
                    curHP = rakeModel:GetAttribute("HP") or rakeModel:GetAttribute("Health")
                    maxHP = rakeModel:GetAttribute("MaxHP") or rakeModel:GetAttribute("MaxHealth")
                end
            end

            if curHP and maxHP and maxHP > 0 then
                local ratio = math.clamp(curHP / maxHP, 0, 1)
                RakeBarFill.Size = UDim2.new(ratio, 0, 1, 0)
                RakeHPText.Text = string.format("❤ THE_RAKE HP: %d / %d (%d%%)", math.floor(math.max(curHP, 0)), math.floor(maxHP), math.floor(ratio * 100))
