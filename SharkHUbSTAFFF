-- World Luck Handlers with fixed state & visual toggle logic
local currentLuckMultiplier = nil
local luckBtnMap = {}

local function registerLuckBtn(btn, stroke, grad, mult)
    luckBtnMap[mult] = {btn = btn, stroke = stroke, grad = grad}
end

registerLuckBtn(Luck250Btn, Luck250Stroke, Luck250Grad, 2.5)
registerLuckBtn(Luck500Btn, Luck500Stroke, Luck500Grad, 5.0)
registerLuckBtn(Luck750Btn, Luck750Stroke, Luck750Grad, 7.5)
registerLuckBtn(Luck1000Btn, Luck1000Stroke, Luck1000Grad, 10.0)

local function handleLuckToggle(multiplier)
    if currentLuckMultiplier == multiplier then
        LUCK_ACTIVE = false
        currentLuckMultiplier = nil
        if luckLoop then task.cancel(luckLoop) luckLoop = nil end

        for _, data in pairs(luckBtnMap) do
            data.btn.Text = string.gsub(data.btn.Text, ": ON", ": OFF")
            data.grad.Color = GREEN_OFF_GRADIENT
            data.stroke.Color = Color3.fromRGB(15, 80, 40)
        end
    else
        LUCK_ACTIVE = true
        currentLuckMultiplier = multiplier
        if luckLoop then task.cancel(luckLoop) end

        for mult, data in pairs(luckBtnMap) do
            if mult == multiplier then
                data.btn.Text = string.gsub(data.btn.Text, ": OFF", ": ON")
                data.grad.Color = GREEN_ON_GRADIENT
                data.stroke.Color = Color3.fromRGB(0, 255, 150)
            else
                data.btn.Text = string.gsub(data.btn.Text, ": ON", ": OFF")
                data.grad.Color = GREEN_OFF_GRADIENT
                data.stroke.Color = Color3.fromRGB(15, 80, 40)
            end
        end

        luckLoop = task.spawn(function()
            while LUCK_ACTIVE do
                fireRemoteAction("SpawnDrop", "LuckBoost", multiplier)
                fireRemoteAction("DropItem", "GoldenApple", multiplier)
                task.wait(0.35)
            end
        end)
    end
end

Luck250Btn.MouseButton1Click:Connect(function() handleLuckToggle(2.5) end)
Luck500Btn.MouseButton1Click:Connect(function() handleLuckToggle(5.0) end)
Luck750Btn.MouseButton1Click:Connect(function() handleLuckToggle(7.5) end)
Luck1000Btn.MouseButton1Click:Connect(function() handleLuckToggle(10.0) end)

