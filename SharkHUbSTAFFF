local function playerHasItem(itemName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char and char:FindFirstChild(itemName) then return true end
    if backpack and backpack:FindFirstChild(itemName) then return true end
    return false
end

-- Fast Direct Lookup instead of game:GetDescendants() loop lag
local function checkAlreadyOwns(itemName)
    local folder = ReplicatedStorage:FindFirstChild("AlreadyOwns") 
        or Workspace:FindFirstChild("AlreadyOwns") 
        or LocalPlayer:FindFirstChild("AlreadyOwns")
        
    if folder and folder:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function findTraderMark()
    local traderFolder = Workspace:FindFirstChild("Trader") or Workspace:FindFirstChild("Traders")
    if traderFolder then
        local mark = traderFolder:FindFirstChild("Mark")
        if mark then return mark end
    end
    return Workspace:FindFirstChild("Mark", true)
end

