local function playerHasItem(itemName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char and char:FindFirstChild(itemName) then return true end
    if backpack and backpack:FindFirstChild(itemName) then return true end
    return false
end

local function checkAlreadyOwns(itemName)
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == "AlreadyOwns" or obj.Name == "AlreadyOwned" then
            if obj:FindFirstChild(itemName) then
                return true
            end
        end
    end
    return false
end

local function findTraderMark()
    local traderFolder = Workspace:FindFirstChild("Trader") or Workspace:FindFirstChild("Traders", true)
    if traderFolder then
        local mark = traderFolder:FindFirstChild("Mark") or traderFolder:FindFirstChild("Mark", true)
        if mark then return mark end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Mark" and obj.Parent and string.find(string.lower(obj.Parent.Name), "trader") then
            return obj
        end
    end
    return nil
end

local function bringDropToPlayer(obj)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if USE_WHITELIST then
        local matched = false
        for targetName, _ in pairs(TARGET_ITEMS_LOOKUP) do
            if string.find(string.lower(obj.Name), string.lower(targetName)) then
                matched = true
                break
            end
        end
        if not matched then return end
    end

    local function pullPart(part)
        if part:IsA("BasePart") then
            part.CFrame = hrp.CFrame
            if firetouchinterest then
                firetouchinterest(hrp, part, 0)
                firetouchinterest(hrp, part, 1)
            end
        end
    end

    if obj:IsA("BasePart") then
        pullPart(obj)
    else
        for _, descendant in ipairs(obj:GetDescendants()) do
            if descendant:IsA("BasePart") then pullPart(descendant) end
        end
    end
end

